#!/usr/bin/env bash
# ddc-input-select — switch the active input on a Dell U5226KW via DDC/CI.
#
# Usage:
#   ddc-input-select            # open picker (walker --dmenu), switch on selection
#   ddc-input-select --current  # print current input as "<code>\t<name>"
#   ddc-input-select --list     # print all configured inputs as "<code>\t<name>"
#   ddc-input-select --help     # show this help
#
# Config: ${XDG_CONFIG_HOME:-$HOME/.config}/ddc-input-select/inputs.json
# Schema: { "inputs": [ { "code": "0x13", "name": "Home Laptop", "hidden": false } ] }
# Entries with "hidden": true are omitted from the picker but still resolved by --current.

set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/ddc-input-select"
CONFIG_FILE="$CONFIG_DIR/inputs.json"
EXAMPLE_CONFIG="${DDC_INPUT_SELECT_EXAMPLE:-/usr/share/ddc-input-select/inputs.example.json}"
VCP_INPUT_SOURCE="60"

die() { notify_err "$1"; echo "ddc-input-select: $1" >&2; exit 1; }

notify_ok()  { command -v notify-send >/dev/null && notify-send "Monitor input" "$1" || true; }
notify_err() { command -v notify-send >/dev/null && notify-send -u critical "Monitor input" "$1" || true; }

ensure_config() {
  if [[ -f "$CONFIG_FILE" ]]; then return; fi
  mkdir -p "$CONFIG_DIR"
  if [[ -f "$EXAMPLE_CONFIG" ]]; then
    cp "$EXAMPLE_CONFIG" "$CONFIG_FILE"
    echo "ddc-input-select: seeded $CONFIG_FILE from $EXAMPLE_CONFIG" >&2
  else
    die "no config at $CONFIG_FILE and no example at $EXAMPLE_CONFIG"
  fi
}

# Normalize a hex code from ddcutil/config into lowercase 0x.. form for comparison.
normalize_code() {
  local raw="${1,,}"
  raw="${raw#0x}"
  raw="${raw#sl=0x}"
  printf '0x%s' "$raw"
}

list_inputs() {
  jq -r '.inputs[] | select((.hidden // false) | not) | "\(.code)\t\(.name)"' "$CONFIG_FILE"
}

current_input() {
  # ddcutil prints e.g. "VCP code 0x60 (Input Source): DisplayPort-1 (sl=0x0f)"
  # or "Invalid value (sl=0x13)" when ddcutil doesn't recognize the code.
  local raw_code
  raw_code=$(ddcutil getvcp "$VCP_INPUT_SOURCE" 2>/dev/null \
    | grep -oE 'sl=0x[0-9a-fA-F]+' \
    | head -1 \
    | cut -d= -f2) || true
  [[ -n "$raw_code" ]] || die "could not read current input from ddcutil"
  local code; code=$(normalize_code "$raw_code")
  local name
  name=$(jq -r --arg c "$code" '
    .inputs[]
    | select((.code | ascii_downcase | sub("^0x"; "0x")) == $c)
    | .name' "$CONFIG_FILE" | head -1)
  [[ -n "$name" ]] || name="(unmapped $code)"
  printf '%s\t%s\n' "$code" "$name"
}

pick_and_switch() {
  command -v walker >/dev/null || die "walker not found in PATH"
  local choices selected code
  choices=$(list_inputs | cut -f2)
  [[ -n "$choices" ]] || die "no inputs configured"

  set +e
  selected=$(printf '%s\n' "$choices" | walker --dmenu -p "Monitor input")
  local rc=$?
  set -e
  # walker exits non-zero on cancel; treat as silent no-op.
  if (( rc != 0 )) || [[ -z "$selected" ]]; then
    exit 0
  fi

  code=$(jq -r --arg n "$selected" '
    .inputs[] | select((.hidden // false) | not) | select(.name == $n) | .code' "$CONFIG_FILE" \
    | head -1)
  [[ -n "$code" ]] || die "no code mapped for selection: $selected"

  # Strip 0x prefix because ddcutil setvcp accepts plain hex.
  local hex="${code#0x}"; hex="${hex#0X}"
  if err=$(ddcutil setvcp "$VCP_INPUT_SOURCE" "0x${hex}" 2>&1); then
    notify_ok "Switched to $selected"
  else
    die "ddcutil failed: ${err}"
  fi
}

main() {
  case "${1:-}" in
    -h|--help)
      awk 'NR==1 {next} /^#/ {sub(/^# ?/,""); print; next} {exit}' "$0"
      ;;
    --list)
      ensure_config
      list_inputs
      ;;
    --current)
      ensure_config
      current_input
      ;;
    "")
      ensure_config
      pick_and_switch
      ;;
    *)
      die "unknown argument: $1 (try --help)"
      ;;
  esac
}

main "$@"
